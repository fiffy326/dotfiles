font-family = Monaspace Krypton
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss06
font-feature = ss07
font-feature = ss09
font-size = 12
cursor-style-blink = false
theme = catppuccin-mocha.conf
mouse-scroll-multiplier = 1.5
background-opacity = 0.85
command = ${SHELL:-/usr/bin/bash}
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-inherit-font-size = false
window-new-tab-position = end
resize-overlay-duration = 250ms
clipboard-read = allow
confirm-close-surface = false
app-notifications = false
