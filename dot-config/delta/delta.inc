[include]
    path = ~/.config/delta/themes/catppuccin.inc
[core]
    pager = delta
[delta]
    dark = true
    navigate = true
    true-color = always
    features = catppuccin-mocha
    line-numbers = true
    side-by-side = true
[interactive]
    diffFilter = delta --color-only
[merge]
    conflictStyle = zdiff3
