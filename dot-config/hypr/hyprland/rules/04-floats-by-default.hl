# Force specific windows to float by default whenever spawned.
windowrulev2 = float, class:(^electron$), title:(^Open Files$)
windowrulev2 = float, class:(^firewall-config$), title:(^Firewall Configuration$)
windowrulev2 = float, class:(^MyCrypto$), title:(^MyCrypto$)
windowrulev2 = float, class:(^nwg-look$), title:(^nwg-look$)
windowrulev2 = float, class:(^steam$), title:(^Friends List$)
windowrulev2 = float, class:(^steam$), title:(^Steam Settings$)
windowrulev2 = float, class:(^virt-manager$), title:(^QEMU/KVM - Connection Details$)
windowrulev2 = float, class:(^zenity$), title:(^Winetricks.*$)
