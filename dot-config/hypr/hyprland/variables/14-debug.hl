source = ../theme.hl

# debug {

    # Type: bool
    # Default: false
    # Summary: print the debug performance overlay. Disable VFR for accurate results.
    # overlay = false

    # Type: bool
    # Default: false
    # Summary: (epilepsy warning!) flash areas updated with damage tracking
    # damage_blink = false

    # Type: bool
    # Default: true
    # Summary: disable logging to a file
    # disable_logs = true

    # Type: bool
    # Default: true
    # Summary: disables time logging
    # disable_time = true

    # Type: int
    # Default: 2
    # Summary: redraw only the needed bits of the display. Do **not** change. (default: full - 2) monitor - 1, none - 0
    # damage_tracking = 2

    # Type: bool
    # Default: false
    # Summary: enables logging to stdout
    # enable_stdout_logs = false

    # Type: int
    # Default: 0
    # Summary: set to 1 and then back to 0 to crash Hyprland.
    # manual_crash = 0

    # Type: bool
    # Default: false
    # Summary: if true, do not display config file parsing errors.
    # suppress_errors = false

    # Type: int
    # Default: 5
    # Summary: sets the timeout in seconds for watchdog to abort processing of a signal of the main thread. Set to 0 to disable.
    # watchdog_timeout = 5

    # Type: bool
    # Default: false
    # Summary: disables verification of the scale factors. Will result in pixel alignment and rounding errors.
    # disable_scale_checks = false

    # Type: int
    # Default: 5
    # Summary: limits the number of displayed config file parsing errors.
    # error_limit = 5

    # Type: int
    # Default: 0
    # Summary: sets the position of the error bar. top - 0, bottom - 1
    # error_position = 0

    # Type: bool
    # Default: true
    # Summary: enables colors in the stdout logs.
    # colored_stdout_logs = true

    # Type: bool
    # Default: false
    # Summary: enables render pass debugging.
    # pass = false

    # Type: bool
    # Default: false
    # Summary: claims support for all cm proto features (requires restart)
    # full_cm_proto = false

# }
