source = ../theme.hl

# xwayland {

    # Type: bool
    # Default: true
    # Summary: allow running applications using X11
    # enabled = true

    # Type: bool
    # Default: true
    # Summary: uses the nearest neighbor filtering for xwayland apps, making them pixelated rather than blurry
    # use_nearest_neighbor = true

    # Type: bool
    # Default: false
    # Summary: forces a scale of 1 on xwayland windows on scaled displays.
    # force_zero_scaling = false

    # Type: bool
    # Default: false
    # Summary: Create the [abstract Unix domain socket](https://wiki.hypr.land/Configuring/XWayland/#abstract-unix-domain-socket) for XWayland connections. (XWayland restart is required for changes to take effect; Linux only)
    # create_abstract_socket = false

# }
