source = ../theme.hl

# gestures {

    # Type: int
    # Default: 300
    # Summary: in px, the distance of the touchpad gesture
    # workspace_swipe_distance = 300

    # Type: bool
    # Default: false
    # Summary: enable workspace swiping from the edge of a touchscreen
    # workspace_swipe_touch = false

    # Type: bool
    # Default: true
    # Summary: invert the direction (touchpad only)
    # workspace_swipe_invert = true

    # Type: bool
    # Default: false
    # Summary: invert the direction (touchscreen only)
    # workspace_swipe_touch_invert = false

    # Type: int
    # Default: 30
    # Summary: minimum speed in px per timepoint to force the change ignoring `cancel_ratio`. Setting to `0` will disable this mechanic.
    # workspace_swipe_min_speed_to_force = 30

    # Type: float
    # Default: 0.5
    # Summary: how much the swipe has to proceed in order to commence it. (0.7 -> if > 0.7 * distance, switch, if less, revert) [0.0 - 1.0]
    # workspace_swipe_cancel_ratio = 0.5

    # Type: bool
    # Default: true
    # Summary: whether a swipe right on the last workspace should create a new one.
    # workspace_swipe_create_new = true

    # Type: bool
    # Default: true
    # Summary: if enabled, switching direction will be locked when you swipe past the `direction_lock_threshold` (touchpad only).
    # workspace_swipe_direction_lock = true

    # Type: int
    # Default: 10
    # Summary: in px, the distance to swipe before direction lock activates (touchpad only).
    # workspace_swipe_direction_lock_threshold = 10

    # Type: bool
    # Default: false
    # Summary: if enabled, swiping will not clamp at the neighboring workspaces but continue to the further ones.
    # workspace_swipe_forever = false

    # Type: bool
    # Default: false
    # Summary: if enabled, swiping will use the `r` prefix instead of the `m` prefix for finding workspaces.
    # workspace_swipe_use_r = false

    # Type: int
    # Default: 1000
    # Summary: the timeout for a window to close when using a 1:1 gesture, in ms
    # close_max_timeout = 1000

# }
