source = ../theme.hl

# cursor {

    # Type: bool
    # Default: false
    # Summary: don't render cursors
    # invisible = false

    # Type: bool
    # Default: true
    # Summary: sync xcursor theme with gsettings, it applies cursor-theme and cursor-size on theme load to gsettings making most CSD gtk based clients use same xcursor theme and size.
    # sync_gsettings_theme = true

    # Type: int
    # Default: 2
    # Summary: disables hardware cursors. 0 - use hw cursors if possible, 1 - don't use hw cursors, 2 - auto (disable when tearing)
    # no_hardware_cursors = 2

    # Type: int
    # Default: 2
    # Summary: disables scheduling new frames on cursor movement for fullscreen apps with VRR enabled to avoid framerate spikes (may require no_hardware_cursors = true) 0 - off, 1 - on, 2 - auto (on with content type 'game')
    # no_break_fs_vrr = 2

    # Type: int
    # Default: 24
    # Summary: minimum refresh rate for cursor movement when `no_break_fs_vrr` is active. Set to minimum supported refresh rate or higher
    # min_refresh_rate = 24

    # Type: int
    # Default: 1
    # Summary: the padding, in logical px, between screen edges and the cursor
    # hotspot_padding = 1

    # Type: float
    # Default: 0
    # Summary: in seconds, after how many seconds of cursor's inactivity to hide it. Set to `0` for never.
    # inactive_timeout = 0

    # Type: bool
    # Default: false
    # Summary: if true, will not warp the cursor in many cases (focusing, keybinds, etc)
    # no_warps = false

    # Type: bool
    # Default: false
    # Summary: When a window is refocused, the cursor returns to its last position relative to that window, rather than to the centre.
    # persistent_warps = false

    # Type: int
    # Default: 0
    # Summary: Move the cursor to the last focused window after changing the workspace. Options: 0 (Disabled), 1 (Enabled), 2 (Force - ignores cursor:no_warps option)
    # warp_on_change_workspace = 0

    # Type: int
    # Default: 0
    # Summary: Move the cursor to the last focused window when toggling a special workspace. Options: 0 (Disabled), 1 (Enabled), 2 (Force - ignores cursor:no_warps option)
    # warp_on_toggle_special = 0

    # Type: str
    # Default: [[Empty]]
    # Summary: the name of a default monitor for the cursor to be set to on startup (see `hyprctl monitors` for names)
    # default_monitor = [[Empty]]

    # Type: float
    # Default: 1.0
    # Summary: the factor to zoom by around the cursor. Like a magnifying glass. Minimum 1.0 (meaning no zoom)
    # zoom_factor = 1.0

    # Type: bool
    # Default: false
    # Summary: whether the zoom should follow the cursor rigidly (cursor is always centered if it can be) or loosely
    # zoom_rigid = false

    # Type: bool
    # Default: true
    # Summary: whether to enable hyprcursor support
    # enable_hyprcursor = true

    # Type: bool
    # Default: false
    # Summary: Hides the cursor when you press any key until the mouse is moved.
    # hide_on_key_press = false

    # Type: bool
    # Default: true
    # Summary: Hides the cursor when the last input was a touch input until a mouse input is done.
    # hide_on_touch = true

    # Type: int
    # Default: 2
    # Summary: Makes HW cursors use a CPU buffer. Required on Nvidia to have HW cursors. 0 - off, 1 - on, 2 - auto (nvidia only)
    # use_cpu_buffer = 2

    # Type: bool
    # Default: false
    # Summary: Warp the cursor back to where it was after using a non-mouse input to move it, and then returning back to mouse.
    # warp_back_after_non_mouse_input = false

    # Type: bool
    # Default: false
    # Summary: disable antialiasing when zooming, which means things will be pixelated instead of blurry
    # zoom_disable_aa = false

# }
